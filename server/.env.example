PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trippilot_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional conversational LLM. Google AI Studio Gemini is supported, as is OpenAI.
# Keep the secret in server/.env only. For Gemini, use GOOGLE_API_KEY or GEMINI_API_KEY.
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_ai_studio_api_key
# Current stable Gemini Flash model. If Google changes availability, check the model list in Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash

# Or use OpenAI instead. Set LLM_PROVIDER=openai and add its API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=45000

# Flight/hotel supplier credentials are not currently connected to provider API clients.
# Adding a provider key alone will not enable live search. Implement and verify a supplier
# connector before adding its credentials here.
